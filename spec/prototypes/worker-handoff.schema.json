{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usk:draft:worker-handoff:0",
  "title": "worker-handoff (unpromoted design)",
  "description": "Proposed contract for review. Not part of the current installed USK ABI or schema set.",
  "type": "object",
  "properties": {
    "format": {
      "const": "usk.draft.worker-handoff/0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_RUN",
              "PASS",
              "FAIL",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "command",
          "status",
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "no-new-authority"
    },
    "fixture_only": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "task_id",
    "spec_digest",
    "repository_commit",
    "changes",
    "checks",
    "blockers",
    "next_action",
    "authority",
    "fixture_only"
  ],
  "additionalProperties": false
}
