{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usk:draft:deployment-response:0",
  "title": "deployment-response (unpromoted design)",
  "description": "Proposed contract for review. Not part of the current installed USK ABI or schema set.",
  "type": "object",
  "properties": {
    "format": {
      "const": "usk.draft.deployment-response/0"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "repair",
        "modify",
        "update",
        "downgrade",
        "uninstall",
        "recover"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "portable",
        "user",
        "machine",
        "native_owner"
      ]
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "ui": {
      "const": "none"
    },
    "reboot_policy": {
      "type": "string",
      "enum": [
        "prohibited",
        "report_only",
        "permitted"
      ]
    },
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
      },
      "minItems": 0
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "format",
    "product_id",
    "bundle_digest",
    "operation",
    "scope",
    "destination",
    "components",
    "ui",
    "reboot_policy",
    "credential_refs",
    "policy_refs"
  ],
  "additionalProperties": false
}
