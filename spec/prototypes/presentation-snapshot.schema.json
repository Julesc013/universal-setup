{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:usk:draft:presentation-snapshot:0",
  "title": "presentation-snapshot (unpromoted design)",
  "description": "Proposed contract for review. Not part of the current installed USK ABI or schema set.",
  "type": "object",
  "properties": {
    "format": {
      "const": "usk.draft.presentation-snapshot/0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "display_name",
        "version"
      ],
      "additionalProperties": false
    },
    "installation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "healthy",
            "damaged",
            "partial",
            "foreign",
            "unknown",
            "recovery_required"
          ]
        }
      },
      "required": [
        "id",
        "state"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "label_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "available": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            },
            "minItems": 0
          },
          "requires_authorization": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label_key",
          "available",
          "reason_codes",
          "requires_authorization"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
          },
          "remedy_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
            },
            "minItems": 0
          }
        },
        "required": [
          "code",
          "severity",
          "message_key",
          "remedy_actions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "operation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "appearance_policy": {
      "type": "string",
      "enum": [
        "system_native",
        "oem_plus",
        "safe_mode"
      ]
    }
  },
  "required": [
    "format",
    "snapshot_id",
    "revision",
    "product",
    "installation",
    "actions",
    "problems",
    "operation_ref",
    "appearance_policy"
  ],
  "additionalProperties": false
}
