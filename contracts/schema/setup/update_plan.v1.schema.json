{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/setup/update_plan.v1.schema.json",
  "title": "Digest-bound Whole-root Update Plan",
  "type": "object",
  "required": ["schema", "plan_id", "plan_digest", "operation", "status", "created_at", "install_id", "transition", "source", "target_root", "old_identity", "new_identity", "planned_entries", "totals", "effects", "retained_root_pattern", "unknown_file_policy", "required_commit_authority", "commit_authority_available", "revalidation"],
  "properties": {
    "schema": { "const": "usk.update_plan.v1" },
    "plan_id": { "$ref": "#/$defs/id" },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "operation": { "const": "update" },
    "status": { "const": "planned" },
    "created_at": { "type": "string", "format": "date-time" },
    "install_id": { "$ref": "#/$defs/id" },
    "transition": { "enum": ["upgrade", "downgrade"] },
    "source": {
      "type": "object", "required": ["path", "sha256", "size_bytes"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 32768 }, "sha256": { "$ref": "#/$defs/sha256" }, "size_bytes": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "target_root": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "old_identity": { "$ref": "#/$defs/old_identity" },
    "new_identity": { "$ref": "#/$defs/new_identity" },
    "planned_entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "totals": {
      "type": "object", "required": ["file_count", "uncompressed_bytes"],
      "properties": { "file_count": { "type": "integer", "minimum": 1 }, "uncompressed_bytes": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "effects": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["effect_id", "kind"],
        "properties": { "effect_id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["retain_root", "replace_root", "write_state"] } },
        "additionalProperties": false
      }
    },
    "retained_root_pattern": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "unknown_file_policy": { "const": "retain_whole_old_root" },
    "required_commit_authority": { "const": "staged_child_bound_v1" },
    "commit_authority_available": { "const": false },
    "revalidation": {
      "type": "object", "required": ["immediately_before_apply", "invalidate_on"],
      "properties": {
        "immediately_before_apply": { "const": true },
        "invalidate_on": { "type": "array", "uniqueItems": true, "items": { "enum": ["source", "recipe", "target", "installed_state", "ownership_manifest", "provider_revision"] } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "native_identity": { "type": "string", "pattern": "^[a-f0-9]{16}:[a-f0-9]{16}$" },
    "old_identity": {
      "type": "object",
      "required": ["installed_state_digest", "ownership_manifest_digest", "product_version", "provider_revision", "recipe_digest", "root_native_identity", "snapshot_digest", "source_archive_digest"],
      "properties": {
        "installed_state_digest": { "$ref": "#/$defs/sha256" }, "ownership_manifest_digest": { "$ref": "#/$defs/sha256" },
        "product_version": { "type": "string", "minLength": 1 }, "provider_revision": { "$ref": "#/$defs/id" },
        "recipe_digest": { "$ref": "#/$defs/sha256" }, "root_native_identity": { "$ref": "#/$defs/native_identity" },
        "snapshot_digest": { "$ref": "#/$defs/sha256" }, "source_archive_digest": { "$ref": "#/$defs/sha256" }
      }, "additionalProperties": false
    },
    "new_identity": {
      "type": "object",
      "required": ["entry_set_digest", "product_version", "provider_revision", "recipe_digest", "snapshot_digest", "source_archive_digest", "source_identity_digest"],
      "properties": {
        "entry_set_digest": { "$ref": "#/$defs/sha256" }, "product_version": { "type": "string", "minLength": 1 },
        "provider_revision": { "$ref": "#/$defs/id" }, "recipe_digest": { "$ref": "#/$defs/sha256" },
        "snapshot_digest": { "$ref": "#/$defs/sha256" }, "source_archive_digest": { "$ref": "#/$defs/sha256" },
        "source_identity_digest": { "$ref": "#/$defs/sha256" }
      }, "additionalProperties": false
    },
    "entry": {
      "type": "object", "required": ["relative_path", "entry_type", "size_bytes", "sha256"],
      "properties": { "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 }, "entry_type": { "const": "file" }, "size_bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
