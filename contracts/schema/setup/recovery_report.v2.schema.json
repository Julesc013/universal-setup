{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/setup/recovery_report.v2.schema.json",
  "title": "Native original-maintenance recovery report",
  "type": "object",
  "required": [
    "operation",
    "install_id",
    "transaction_id",
    "original_plan_id",
    "original_plan_digest",
    "inspection_request_id",
    "target_root",
    "native_binding",
    "available_actions",
    "effects",
    "schema",
    "status",
    "recorded_at",
    "report_id",
    "report_digest"
  ],
  "properties": {
    "operation": {
      "enum": [
        "repair",
        "move",
        "uninstall"
      ]
    },
    "install_id": {
      "type": "string",
      "minLength": 1
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "original_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "original_plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inspection_request_id": {
      "type": "string",
      "minLength": 1
    },
    "target_root": {
      "type": "string",
      "minLength": 1
    },
    "native_binding": {
      "$ref": "native_maintenance_inspection_binding.v1.schema.json"
    },
    "available_actions": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "finalize"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "operation"
        ],
        "properties": {
          "kind": {
            "const": "resume_original_maintenance"
          },
          "operation": {
            "enum": [
              "repair",
              "move",
              "uninstall"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "schema": {
      "const": "usk.recovery_report.v2"
    },
    "status": {
      "enum": [
        "inspection_only",
        "completed"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected_action": {
      "const": "finalize"
    },
    "completed_journal_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completed_effect_history_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "completed_effect_history_sha256",
          "completed_journal_snapshot_sha256",
          "reviewed_plan_digest",
          "reviewed_plan_id",
          "selected_action"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "completed_effect_history_sha256"
              ]
            },
            {
              "required": [
                "reviewed_plan_digest"
              ]
            },
            {
              "required": [
                "reviewed_plan_id"
              ]
            },
            {
              "required": [
                "selected_action"
              ]
            },
            {
              "required": [
                "completed_journal_snapshot_sha256"
              ]
            }
          ]
        }
      }
    }
  ]
}
