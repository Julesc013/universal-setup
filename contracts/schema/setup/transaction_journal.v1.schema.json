{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/setup/transaction_journal.v1.schema.json",
  "title": "Durable Setup Transaction Journal",
  "type": "object",
  "required": [
    "schema",
    "journal_id",
    "journal_digest",
    "transaction_id",
    "plan_id",
    "plan_digest",
    "operation",
    "current_state",
    "created_at",
    "updated_at",
    "roots",
    "transitions",
    "recovery"
  ],
  "dependentSchemas": {
    "required_commit_authority": {
      "required": ["recovery_metadata"],
      "properties": { "recovery_metadata": { "required": ["commit_cleanup_policy"] } }
    }
  },
  "properties": {
    "schema": { "const": "usk.transaction_journal.v1" },
    "required_commit_authority": { "const": "staged_child_bound_v1" },
    "journal_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "journal_digest": { "$ref": "#/$defs/sha256" },
    "transaction_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "operation": { "enum": ["install_local", "repair", "move", "uninstall", "recovery"] },
    "current_state": { "$ref": "#/$defs/state" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "root", "classification"],
        "properties": {
          "role": { "enum": ["source", "target", "old_target", "new_target", "staging", "setup_state", "audit"] },
          "root": { "type": "string", "minLength": 1, "maxLength": 32768 },
          "classification": { "enum": ["read_only_source", "managed_install", "operator_selected_owned_target", "setup_owned", "audit_owned"] }
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "transition_id", "from", "to", "recorded_at", "durable_before_external_visibility"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "transition_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "from": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
          "to": { "$ref": "#/$defs/state" },
          "recorded_at": { "type": "string", "format": "date-time" },
          "durable_before_external_visibility": { "const": true },
          "details_digest": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "recovery_metadata": {
      "type": "object",
      "required": ["staging_identity", "staged_files"],
      "dependentSchemas": {
        "commit_cleanup_policy": { "properties": { "staging_identity": { "type": "null" } } },
        "stream_cleanup_policy": { "properties": { "staging_identity": { "type": "null" } } },
        "stream_journal": {
          "required": ["stream_cleanup_policy"],
          "properties": { "staging_identity": { "type": "null" } }
        }
      },
      "properties": {
        "staging_identity": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "type": "null" }] },
        "stream_cleanup_policy": { "enum": ["retain_only"] },
        "commit_cleanup_policy": { "enum": ["retain_only"], "description": "Commit preparation withholds automatic cleanup authority before child observations; this latch never grants ownership or publication authority." },
        "stream_journal": {
          "type": "object",
          "description": "Explicit replay observations; old staging remains retain-only. The digest covers this object without digest. Completion identity is an observation, never deletion authority.",
          "required": [
            "version",
            "source_digest",
            "restart_origin",
            "entries",
            "digest"
          ],
          "properties": {
            "version": {
              "enum": [1, 2]
            },
            "source_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "restart_origin": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "transaction_id",
                    "snapshot_sha256"
                  ],
                  "properties": {
                    "transaction_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "snapshot_sha256": {
                      "$ref": "#/$defs/sha256"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "entries": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "type": "object",
                "required": [
                  "relative_path",
                  "sha256",
                  "expected_size",
                  "source_identity_digest",
                  "phase",
                  "output_identity"
                ],
                "properties": {
                  "relative_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "expected_size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "source_identity_digest": {
                    "$ref": "#/$defs/sha256"
                  },
                  "phase": {
                    "enum": [
                      "intent",
                      "writing",
                      "complete"
                    ]
                  },
                  "output_identity": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{16}:[a-f0-9]{16}$"
                      }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "phase": {
                          "const": "intent"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "output_identity": {
                          "type": "null"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "output_identity": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ],
                "additionalProperties": false
              }
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            },
            "source_context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "description": "Canonical versioned source context whose SHA256 equals source_digest; an observation, never cleanup authority."
            },
            "publication_root_identity": {
              "type": "string",
              "pattern": "^[a-f0-9]{16}:[a-f0-9]{16}$",
              "description": "Observation-only identity of the owned staging directory published by no-replace commit; never cleanup authority."
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "version": { "const": 2 } }, "required": ["version"] },
              "then": { "required": ["publication_root_identity"] },
              "else": { "not": { "required": ["publication_root_identity"] } }
            },
            {
              "if": {
                "properties": {
                  "restart_origin": {
                    "type": "object"
                  }
                }
              },
              "then": {
                "properties": {
                  "source_digest": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            }
          ]
        },
        "staged_files": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": ["relative_path", "sha256", "size_bytes"],
            "properties": {
              "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "size_bytes": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": ["required", "available_actions"],
      "properties": {
        "required": { "type": "boolean" },
        "available_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["resume", "rollback", "accept_new_root", "retain_for_operator", "abandon"] }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": {
      "enum": [
        "created",
        "validated",
        "planned",
        "staging",
        "staged",
        "verified",
        "committing",
        "committed",
        "completed",
        "refused",
        "failed",
        "recovery_required",
        "rolled_back",
        "abandoned_by_operator"
      ]
    }
  },
  "additionalProperties": false
}
