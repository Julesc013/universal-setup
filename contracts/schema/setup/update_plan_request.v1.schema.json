{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/setup/update_plan_request.v1.schema.json",
  "title": "Whole-root Update Plan Request",
  "type": "object",
  "required": ["schema", "request_id", "plan_id", "install_id", "created_at", "transition", "archive", "target", "recipe", "required_commit_authority"],
  "properties": {
    "schema": { "const": "usk.update_plan_request.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "plan_id": { "$ref": "#/$defs/id" },
    "install_id": { "$ref": "#/$defs/id" },
    "created_at": { "type": "string", "format": "date-time" },
    "transition": { "enum": ["upgrade", "downgrade"] },
    "archive": {
      "type": "object",
      "required": ["path", "format", "expected_sha256", "strip_prefix"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "format": { "const": "zip" },
        "expected_sha256": { "$ref": "#/$defs/sha256" },
        "strip_prefix": { "type": "string", "maxLength": 4096 }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["root", "class"],
      "properties": {
        "root": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "class": { "enum": ["operator_acceptance", "managed_portable"] }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["product_id", "product_version", "recipe_digest", "provider_revision", "components", "entrypoints"],
      "properties": {
        "product_id": { "$ref": "#/$defs/id" },
        "product_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "recipe_digest": { "$ref": "#/$defs/sha256" },
        "provider_revision": { "$ref": "#/$defs/id" },
        "components": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "entrypoints": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["entrypoint_id", "relative_path", "kind"],
            "properties": {
              "entrypoint_id": { "$ref": "#/$defs/id" },
              "relative_path": { "$ref": "#/$defs/relative_path" },
              "kind": { "enum": ["application", "tool", "server"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "required_commit_authority": { "const": "staged_child_bound_v1" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096 }
  },
  "additionalProperties": false
}
