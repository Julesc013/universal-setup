{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/package/component_manifest.v1.schema.json",
  "title": "Universal Setup Component Manifest",
  "type": "object",
  "required": ["schema", "component_id", "platform", "architecture", "entries"],
  "properties": {
    "schema": { "const": "usk.component_manifest.v1" },
    "component_id": { "$ref": "#/$defs/identifier" },
    "platform": { "$ref": "#/$defs/identifier" },
    "architecture": { "$ref": "#/$defs/identifier" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "size_bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "kind": { "enum": ["file", "directory"] },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
