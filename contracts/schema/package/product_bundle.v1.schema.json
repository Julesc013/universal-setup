{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/package/product_bundle.v1.schema.json",
  "title": "Minimal compiled product setup bundle",
  "type": "object",
  "required": ["schema", "product_id", "publisher_id", "product_version", "target", "allowed_scopes", "components", "payload"],
  "properties": {
    "schema": {"const": "usk.product_bundle.v1"},
    "product_id": {"type": "string"},
    "publisher_id": {"type": "string"},
    "product_version": {"type": "string"},
    "target": {"type": "string"},
    "allowed_scopes": {"type": "array", "items": {"type": "string"}},
    "components": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "default_selected", "requires", "conflicts", "files"],
        "properties": {
          "id": {"type": "string"},
          "required": {"type": "boolean"},
          "default_selected": {"type": "boolean"},
          "requires": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "files": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["path", "size_bytes", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "size_bytes": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "payload": {
      "type": "object", "required": ["file", "size_bytes", "sha256"],
      "properties": {
        "file": {"const": "payload.zip"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
