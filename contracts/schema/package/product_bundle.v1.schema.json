{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/package/product_bundle.v1.schema.json",
  "title": "Minimal compiled product setup bundle",
  "type": "object",
  "required": ["schema", "product_id", "publisher_id", "product_version", "target", "allowed_scopes", "components", "payload"],
  "properties": {
    "schema": {"const": "usk.product_bundle.v1"},
    "product_id": {"$ref": "#/$defs/id"},
    "publisher_id": {"$ref": "#/$defs/id"},
    "product_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {"$ref": "#/$defs/id"},
    "allowed_scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["portable", "per_user", "machine"]}
    },
    "components": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["id", "required", "default_selected", "requires", "conflicts", "files"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "default_selected": {"type": "boolean"},
          "requires": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "conflicts": {"type": "array", "maxItems": 65536, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "files": {
            "type": "array", "minItems": 1, "maxItems": 65536,
            "items": {
              "type": "object", "required": ["path", "size_bytes", "sha256"],
              "properties": {
                "path": {"$ref": "#/$defs/path"},
                "size_bytes": {"type": "integer", "minimum": 0},
                "sha256": {"$ref": "#/$defs/sha256"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "payload": {
      "type": "object", "required": ["file", "size_bytes", "sha256"],
      "properties": {
        "file": {"const": "payload.zip"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[ -~]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
