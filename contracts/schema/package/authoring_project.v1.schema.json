{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://julesc013.github.io/universal-setup/contracts/schema/package/authoring_project.v1.schema.json",
  "title": "Minimal declarative product authoring project",
  "type": "object",
  "required": ["schema", "product_id", "publisher_id", "product_version", "allowed_scopes", "components"],
  "properties": {
    "schema": {"const": "usk.authoring_project.v1"},
    "product_id": {"$ref": "#/$defs/id"},
    "publisher_id": {"$ref": "#/$defs/id"},
    "product_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "allowed_scopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["portable", "per_user", "machine"]}
    },
    "components": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["id", "required", "default_selected", "requires", "conflicts", "variants"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "default_selected": {"type": "boolean"},
          "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "variants": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["target", "files"],
              "properties": {
                "target": {"$ref": "#/$defs/id"},
                "files": {
                  "type": "array", "minItems": 1,
                  "items": {
                    "type": "object", "required": ["source", "path"],
                    "properties": {
                      "source": {"$ref": "#/$defs/path"},
                      "path": {"$ref": "#/$defs/path"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[ -~]+$"}
  },
  "additionalProperties": false
}
